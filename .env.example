# Copy to .env for local development. Never commit .env — gitleaks will catch it
# in CI, but the pre-commit hook catches it before it costs you a force-push.

COMPLYLAYER_SECRET_KEY=insecure-development-key-do-not-deploy
COMPLYLAYER_DEBUG=1

COMPLYLAYER_DB_NAME=complylayer
COMPLYLAYER_DB_USER=complylayer
COMPLYLAYER_DB_PASSWORD=complylayer
COMPLYLAYER_DB_HOST=127.0.0.1
COMPLYLAYER_DB_PORT=5432

COMPLYLAYER_REDIS_URL=redis://127.0.0.1:6379/2

# Only if the conventional ports are already taken on your machine. The compose
# file falls back to 5432 and 6379 when these are unset.
# COMPLYLAYER_DB_PORT=55432
# COMPLYLAYER_REDIS_PORT=56379
# COMPLYLAYER_REDIS_URL=redis://127.0.0.1:56379/2
