# Copy to .env for local development. Never commit .env — gitleaks will catch it
# in CI, but the pre-commit hook catches it before it costs you a force-push.

# Both of these are refused at startup when COMPLYLAYER_DEBUG is off — the
# values below are published in this repository, so they are development-only by
# definition. Generate real ones with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
#
# COMPLYLAYER_CUSTOMER_SALT is the HMAC key that pseudonymises customer
# references before they are stored. It cannot be rotated freely: changing it
# re-pseudonymises every future decision, so the history stops joining to the
# new value. Set it once, keep it in a secret manager rather than beside the
# database, and back it up with the database.
COMPLYLAYER_SECRET_KEY=insecure-development-key-do-not-deploy
COMPLYLAYER_CUSTOMER_SALT=insecure-development-salt-do-not-deploy
COMPLYLAYER_DEBUG=1

COMPLYLAYER_DB_NAME=complylayer
COMPLYLAYER_DB_USER=complylayer
COMPLYLAYER_DB_PASSWORD=complylayer
COMPLYLAYER_DB_HOST=127.0.0.1
COMPLYLAYER_DB_PORT=5432

COMPLYLAYER_REDIS_URL=redis://127.0.0.1:6379/2

# /metrics is labelled by tenant, so it is a customer list, and it is served on
# the same port as the decision endpoint. Unset leaves it open, which is fine on
# a laptop. Set it anywhere anyone else can reach; Prometheus sends it with
# `bearer_token_file` in the scrape config.
# COMPLYLAYER_METRICS_TOKEN=

# Only if the conventional ports are already taken on your machine. The compose
# file falls back to 5432 and 6379 when these are unset.
# COMPLYLAYER_DB_PORT=55432
# COMPLYLAYER_REDIS_PORT=56379
# COMPLYLAYER_REDIS_URL=redis://127.0.0.1:56379/2
